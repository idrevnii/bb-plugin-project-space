{
  "name": "bb-plugin-project-space",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.16"
  },
  "bb": {
    "name": "Project Space",
    "description": "A full-screen documentation space per project: Markdown pages, browser-rendered HTML, and tldraw canvases that agents and you edit together, stored in .bb-space/.",
    "branding": {
      "icon": "Layers"
    },
    "server": "./server/index.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tldraw": "^5.5.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.16",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.isequalwith": "^4.4.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/lodash.uniq": "^4.5.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "playwright": "^1.63.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^5.0.3"
  },
  "description": "A full-screen documentation space per project: Markdown pages, browser-rendered HTML, and tldraw canvases that agents and you edit together, stored in .bb-space/.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bb plugin build",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e": "node scripts/e2e/smoke.mjs && node scripts/e2e/live-refresh.mjs && node scripts/e2e/draw.mjs && node scripts/e2e/annotations.mjs"
  }
}
